# Environment configuration for vialo-dhcp.
# Copy to /etc/vialo/dhcp.env (root:root, mode 0600) and fill in the values.
# Every setting maps to a clap argument in src/main.rs.

# Postgres connection string (required).
DATABASE_URL=postgres://user:password@localhost/vialo

# Server identifier IP — must be an IP on the listen interface (required).
SIADDR=192.0.2.1

# Comma-separated interface names to bind. Empty = all interfaces.
# Pin a single interface in production (enables SO_BINDTODEVICE).
INTERFACES=eth0

# DHCP server listen address (default 0.0.0.0:67).
#LISTEN=0.0.0.0:67

# Lease duration in seconds; T1/renew and T2/rebind are derived from it (default 10800).
#LEASE_TIME=10800

# How long a declined address stays quarantined, in seconds (default 3600).
#PROBATION=3600

# How to read a VLAN from the option 82 Agent Circuit ID: off, ascii, or binary (default ascii).
#CIRCUIT_ID_VLAN=ascii

# Maximum size of the Postgres connection pool (default 5).
#PG_MAX_CONNECTIONS=5
