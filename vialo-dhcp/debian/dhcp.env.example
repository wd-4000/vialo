# Optional environment configuration for vialo-dhcp
# Copy to /etc/vialo/dhcp.env (root:root, mode 0600) to override the defaults.
#
# Everything else lives in the [dhcp] section of /etc/vialo/vialo.toml. See
# vialo.example.toml for the keys and their defaults. The unit points the
# binary at that file itself; you only need VIALO_CONFIG here to override it.

# Defaults to peer auth on the local PostgreSQL (`vialo db init`)
#DATABASE_URL=postgresql:///vialo?host=/run/postgresql&user=vialo-dhcp

# Log filter (default info).
#RUST_LOG=info
