# Environment configuration for vialo-dhcp.
# Copy to /etc/vialo/dhcp.env (root:root, mode 0600) and fill in the values.
#
# Everything else lives in the [dhcp] section of /etc/vialo/vialo.toml — see
# vialo.example.toml for the keys and their defaults. The unit points the
# binary at that file itself; you only need VIALO_CONFIG here to override it.

# Postgres connection string (required).
DATABASE_URL=postgres://user:password@localhost/vialo

# Log filter (default info).
#RUST_LOG=info
