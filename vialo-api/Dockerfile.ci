# syntax=docker/dockerfile:1
# CI variant of the Dockerfile: uses cargo-chef so compiled dependencies live
# in an image layer that buildx can export to the GitHub Actions cache
# (cache mounts don't survive between CI runners). For local compose builds
# use the plain Dockerfile — keep the final stage of both files in sync!
FROM rust:1.97-alpine AS chef

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static cargo-chef

WORKDIR /usr/src/vialo

# I Do Not Care
ENV RUSTFLAGS=-Awarnings
ENV OPENSSL_DIR=/usr
ENV OPENSSL_STATIC=1

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
ARG PROFILE=release

# Build only vialo-api's dependencies. This layer stays cached until the
# manifests/lockfile change. Env and flags must match the real build below,
# or cargo rebuilds everything anyway.
COPY --from=planner /usr/src/vialo/recipe.json recipe.json
RUN cargo chef cook --profile $PROFILE --features migrate -p vialo-api --recipe-path recipe.json

COPY . .

# Build it for real. --bin keeps openapi-spec out of this stage so image
# builds (notably the arm64 leg) don't pay for compiling it. --locked turns
# lockfile drift into a hard error instead of a silent re-resolve.
RUN TARGET_DIR=$(echo $PROFILE | sed 's/^dev$/debug/') && \
    SQLX_OFFLINE=true cargo build --locked --profile $PROFILE --features migrate -p vialo-api --bin vialo-api && \
    cp target/$TARGET_DIR/vialo-api /vialo-api
# We use cached SQLX queries (SQLX_OFFLINE=true).
# This means you need to run `cargo sqlx prepare` to update the cache!

# Spec generation. The runtime image below doesn't depend on these stages, so
# plain image builds skip them; CI builds with --target openapi to get the
# spec for the docs (cheap: everything but the small bin is already compiled).
FROM builder AS spec-builder
RUN TARGET_DIR=$(echo $PROFILE | sed 's/^dev$/debug/') && \
    SQLX_OFFLINE=true cargo build --locked --profile $PROFILE --features migrate -p vialo-api --bin openapi-spec && \
    target/$TARGET_DIR/openapi-spec /openapi.json

FROM scratch AS openapi
COPY --from=spec-builder /openapi.json /

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /vialo-api /usr/local/bin/vialo-api
WORKDIR /app
ENV VIALO_CONFIG=/app/vialo.toml

ENTRYPOINT ["vialo-api"]
