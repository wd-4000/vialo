# Environment configuration for vialo-api.
# Copy to /etc/vialo/api.env (root:root, mode 0600) and fill in the values.
# The service already gets DATABASE_URL from cargo-deb/systemd; the rest are
# optional per the features enabled at build time.

# Postgres connection string (required — the service panics without it).
DATABASE_URL=postgres://user:password@localhost/vialo

# Encryption key: 32 bytes as 64 hex chars (required in production).
# The debug default is insecure — this MUST be set on real deployments.
ENCRYPTION_KEY=

# Kratos admin API URL (required with AuthConfig::Kratos; not used in mock auth).
#ORY_KRATOS_ADMIN_URL=http://localhost:4434

# Email — required when the `email` feature is enabled.
#EMAIL_URL=smtp://localhost:25

# Printer — required when the `printer` feature is enabled.
#PRINTER_URL=
#PRINTER_PASSWORD=

# Optional: set the intial admin email if no accounts exist yet.
#INITIAL_ADMIN_EMAIL=
