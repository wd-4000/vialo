# Environment configuration for vialo-api, /etc/vialo/api.env (root, 0600).
# The package creates it from this template on first install.
# Non-secret settings live in /etc/vialo/vialo.toml (see vialo.example.toml in
# /usr/share/doc/vialo-api).

# Defaults to peer auth on the local PostgreSQL (`vialo db init`)
#DATABASE_URL=postgresql:///vialo?host=/run/postgresql&user=vialo-api

# Encrypts the stored Wi-Fi credentials: 32 bytes as 64 hex chars. Generated on
# install. Back it up; the credentials can't be read without it.
ENCRYPTION_KEY=

# HOOKS_KEY lives in /etc/vialo/hooks.env, generated on install and shared
# with vialo-kratos.

# Email — required when the `email` feature is enabled.
#EMAIL_URL=smtp://localhost:25

# Printer — required when the `printer` feature is enabled.
#PRINTER_URL=
#PRINTER_PASSWORD=

# Optional: set the intial admin email if no accounts exist yet.
#INITIAL_ADMIN_EMAIL=
