[Unit]
Description=Vialo API hooks socket
Documentation=https://github.com/wd-4000/vialo

[Socket]
# TCP because Kratos' webhooks can't use Unix sockets. Requests need HOOKS_KEY
# from /etc/vialo/hooks.env; still don't publish this port.
ListenStream=127.0.0.1:8011
FileDescriptorName=hooks
Service=vialo-api.service

[Install]
WantedBy=sockets.target
