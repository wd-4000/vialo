#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
	install -d -m 755 /etc/vialo
	# Shared secret for the hooks API, also read by vialo-kratos
	if [ ! -e /etc/vialo/hooks.env ]; then
		(umask 077 && printf 'HOOKS_KEY=%s\n' "$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')" > /etc/vialo/hooks.env)
	fi
	if [ ! -e /etc/vialo/api.env ]; then
		key=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
		(umask 077 && sed "s/^ENCRYPTION_KEY=\$/ENCRYPTION_KEY=$key/" /usr/share/vialo-api/api.env.example > /etc/vialo/api.env)
	fi
fi

#DEBHELPER#
