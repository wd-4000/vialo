{{#*inline "content"}}
    <tr>
        <td>
            <div style="border: solid #ddd 1px;border-radius: 5px; padding: 10px 15px; margin-top: 10px;">
                <h2>{{message.post.title}}</h2>
                {{#if message.post.time}}
                <p style="margin-bottom: 2px">{{message.post.time}}</p>
                {{/if}}
                <p style="word-break: break-word;">{{{message.post.content_html}}}</p>
            </div>
        </td>
    </tr>
    <tr>
        <td>
            <a rel="noopener" target="_blank" href="{{message.post.url}}" style="background-color: #A02C89; font-size: 18px; text-decoration: none; padding: 10px 20px; color: #ffffff; border-radius: 5px; display: inline-block; margin-top: 10px;">{{> read_more}}</a>
        </td>
    </tr>
    {{#if group.email}}
    <tr>
        <td>
            <p style="margin: 15px 0 0 0; overflow-wrap: break-word; word-wrap: break-word;">
                {{> email_replyable}}
            </p>
        </td>
    </tr>
    {{/if}}
{{/inline}}
{{> html/message}}
