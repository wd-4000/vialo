<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="format-detection" content="telephone=no">
  <style>
            * {
                word-break: break-word;
            }
            a {
                border: none;
                text-decoration: none;
                color: #2196f3;
            }

            a:hover {
                color: #2196f3 !important;
            }

            p {
                margin: 0;
            }

            h2 {
                margin: 0;
                padding: 0;
            }

            table {
                border-collapse: collapse;
            }

                  .slot {
                   padding: 25px 20px 20px 20px;
                }

            .footer{
                padding: 20px 20px 0 20px;
            }

            @media screen and (min-width: 600px) {
                body {
                    padding: 20px;
                }

                .rounded{
                border-radius: 4px 4px 0 0;
                }
                .slot {
                    padding: 25px 30px 20px 30px;
                }

                   .footer{
                padding: 20px 30px 0 32px;
            }
            }
  </style>
</head>

<body
  style="margin: 0; background-color: #eceff1; font-weight: 400; padding-bottom:30px; font-size: 14px; color: #546e7a; font-family: 'Open Sans', 'Helvetica Neue', Helvetica, 'Noto Sans', Arial, sans-serif; letter-spacing: 0; max-width: 100vw">
  <table style="width: 100%;">
    <tbody>


      <tr>
        <td style="padding: 0;">
          <table style="margin: 0 auto; width: 100%; max-width: 600px">
            <tbody>
              <tr>
                <td style="padding: 15px 0 15px 0;  background: #a02c89;" class="rounded">
                  <img
                    src="https://example.com/TODO.png"
                    alt="XYZ" style="display: block; margin: 0 auto;" height="45">
                </td>
              </tr>
              <tr>
                <td style="border-radius: 0 0 4px 4px; background: #ffffff;" class="slot">
                        {{> slot }}
                </td>
              </tr>
              <tr>
                <td
                  style="color: #808080; font-family: Helvetica, Arial, sans-serif; font-size: 12px;" class="footer">
                  <p>

                  </p>
                  <h3 style="margin: 0 0 5px 0;">
                    {{> org_name}}
                  </h3>
                  <p>
                    {{> org_impressum}}
                  </p>
                  <p style="margin: 10px 0 0 0;">{{> footer_disclaimer}}</p>
                </td>
              </tr>
            </tbody>
          </table>
        </td>
      </tr>
    </tbody>
  </table>
</body>
</html>
