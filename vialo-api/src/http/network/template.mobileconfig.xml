<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>AutoJoin</key>
			<true/>
			<key>CaptiveBypass</key>
			<false/>
			<key>DisableAssociationMACRandomization</key>
			<true/>
			<key>EAPClientConfiguration</key>
			<dict>
				<key>AcceptEAPTypes</key>
				<array>
					<integer>21</integer>
				</array>
				<key>OuterIdentity</key>
				<string>{outer_identity}</string>
				<key>TLSMaximumVersion</key>
				<string>1.3</string>
				<key>TLSMinimumVersion</key>
				<string>1.0</string>
				<key>TLSTrustedServerNames</key>
				<array>
					<string>{network_tlstrust}</string>
				</array>
				<key>TTLSInnerAuthentication</key>
				<string>EAP</string>
				<key>UserName</key>
				<string>{username}</string>
				<key>UserPassword</key>
				<string>{password}</string>
			</dict>
			<key>EncryptionType</key>
			<string>WPA2</string>
			<key>HIDDEN_NETWORK</key>
			<false/>
			<key>IsHotspot</key>
			<false/>
			<key>PayloadDescription</key>
			<string>Configures Wi-Fi settings</string>
			<key>PayloadDisplayName</key>
			<string>Wi-Fi</string>
			<key>PayloadIdentifier</key>
			<string>com.apple.wifi.managed.{network_id}</string>
			<key>PayloadType</key>
			<string>com.apple.wifi.managed</string>
			<key>PayloadUUID</key>
			<string>{network_id}</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>ProxyType</key>
			<string>None</string>
			<key>SSID_STR</key>
			<string>{network_ssid}</string>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>This personalized profile connects your Apple devices to {network_label}.</string>
	<key>PayloadDisplayName</key>
	<string>{network_label} ({account_full_name})</string>
	<key>PayloadIdentifier</key>
	<string>vialo-{network_id}-{cred_id}</string>
	<key>PayloadOrganization</key>
	<string>{org_name}</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>{cred_id}</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
