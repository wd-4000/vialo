{
  "db_name": "PostgreSQL",
  "query": "SELECT\n                bp.id,\n                bp.account_id,\n                bp.board_id,\n                bp.icon,\n                -- Use get_i18n_string for title, content, and location translations with fallback\n                get_i18n_string(bp.title, $1) AS title,\n                get_i18n_string(bp.content_plain, $1) AS content_plain,\n                NULL as content_html,\n                get_i18n_string(bp.content, $1) AS content,\n                get_i18n_string(bp.location, $1) AS location,\n                bp.event_from,\n                bp.event_to,\n                bp.created_at\n            FROM\n                board_posts bp\n            LEFT JOIN board_group_perms bgp ON bp.board_id = bgp.board_id\n            LEFT JOIN account_group_memberships agm ON bgp.group_id = agm.group_id\n            WHERE bp.id = $2 AND TRUE",
