{
  "db_name": "PostgreSQL",
  "query": "SELECT\n            ba.id,\n            ba.asset_id,\n            ba.transaction_id,\n            null AS \"account: AccountEmbed\",\n            lower(ba.during) as begins,\n            coalesce(upper(ba.during), '+infinity'::timestamptz) as \"ends!: PgDateTime\",\n            ba.cancelled_at,\n            ba.cancellation_reason as \"cancellation_reason: CancellationReason\",\n            ba.activated,\n            ba.maintenance\n        FROM\n            bookable_appointments ba JOIN bookable_assets b ON b.id = ba.asset_id LEFT JOIN accounts_people ap ON ba.account_id = ap.id LEFT JOIN account_groups ag ON ba.account_id = ag.id WHERE true\n            AND (ba.account_id = $1 OR b.asset_type_id = ANY($2)) AND ba.account_id = $3 AND b.asset_type_id = ANY($4) AND coalesce(upper(ba.during), 'infinity'::timestamptz) >= $5  AND UPPER(ba.during) <= $6  AND ba.cancelled_at IS NULL ORDER BY ba.during, ba.id LIMIT $7 OFFSET $8",
