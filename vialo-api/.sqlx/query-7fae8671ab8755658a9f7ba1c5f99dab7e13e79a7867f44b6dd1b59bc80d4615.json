  "query": "SELECT\n                id as \"id!\",\n                icon,\n                get_i18n_string(name_i18n, $1) AS name,\n                asset_type_id as \"asset_type_id!\",\n                status as \"status!: BookableStatus\",\n                begins,\n                ends as \"ends: PgDateTime\"\n            FROM\n                bookable_asset_status\n            WHERE account_bookable_perm_exists($2, asset_type_id, 'view'::bookable_perm)\n            AND asset_type_id = ANY($3) ORDER BY id LIMIT $4 OFFSET $5",
