  "query": "update bookable_assets set quick_unlock = tstzrange(now(), now() + '1 minute', '[]') WHERE id = $1 AND (NOT (quick_unlock @> now()) OR quick_unlock IS NULL) RETURNING $1 as \"id!\", asset_type_id as \"asset_type_id!\", 'quick_unlock'::bookable_status_type as \"status!: BookableStatus\",\n    now() as begins,\n   (now() + '1 minute') as \"ends: PgDateTime\",\n   NULL::uuid as appointment_id;",
