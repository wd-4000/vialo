  "query": "SELECT ag.id, ag.label, ag.icon, ag.email, get_i18n_string(ag.description_i18n, $1) AS description, null as \"accounts: Vec<AccountPersonEmbed>\" FROM account_groups ag JOIN account_group_memberships agm on ag.id = agm.group_id JOIN current_room_occupants cro ON agm.account_id = cro.id WHERE TRUE AND ag.id = $2 GROUP BY ag.id",
