  "query": "SELECT nr.* FROM net_realms nr JOIN net_realm_assignments nra ON nra.realm_id = nr.id WHERE nra.account_id = $1 AND (ipv4_subnet::text ILIKE '%' || $2 || '%' OR ipv4_nat::text ILIKE '%' || $2 || '%' OR ipv6_prefix::text ILIKE '%' || $2 || '%') ORDER BY id ASC LIMIT $3 OFFSET $4",
