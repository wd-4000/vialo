  "query": "SELECT nr.id, nr.ipv4_subnet, nr.ipv4_nat, nr.ipv4_router, nr.ipv4_dns, nr.ipv4_dhcp_server, nr.ipv6_prefix, nr.vlan FROM net_realms nr JOIN net_realm_assignments nra ON nra.realm_id = nr.id WHERE nra.account_id = $1 AND (ipv4_subnet::text ILIKE '%' || $2 || '%' OR ipv4_nat::text ILIKE '%' || $2 || '%' OR ipv6_prefix::text ILIKE '%' || $2 || '%') ORDER BY id ASC LIMIT $3 OFFSET $4",
