  "query": "update bookable_assets set quick_unlock = tsrange(LOCALTIMESTAMP, LOCALTIMESTAMP + '1 minute', '[]') WHERE id = $1 AND (NOT (quick_unlock @> now()::timestamp) OR quick_unlock IS NULL) RETURNING $1 as \"id!\", asset_type_id as \"asset_type_id!\", 'quick_unlock'::bookable_status_type as \"status!: BookableStatus\",\n    LOCALTIMESTAMP as begins,\n   (LOCALTIMESTAMP + '1 minute') as \"ends: PgDateTime\";",
