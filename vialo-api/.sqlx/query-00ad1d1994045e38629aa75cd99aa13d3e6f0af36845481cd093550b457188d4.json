{
  "db_name": "PostgreSQL",
  "query": "SELECT ag.id, ag.label, ag.icon, ag.email, get_i18n_string(ag.description_i18n, $1) AS description, array_agg(jsonb_build_object('id', cro.id, 'full_name', cro.full_name, 'room', (CASE WHEN cro.room_id IS NOT NULL THEN jsonb_build_object('id', cro.room_id, 'label', cro.room_name) ELSE NULL END))) as \"accounts: Vec<AccountPersonEmbed>\" FROM account_groups ag JOIN account_group_memberships agm on ag.id = agm.group_id JOIN current_room_occupants cro ON agm.account_id = cro.id WHERE ag.public = true AND ag.id = $2 GROUP BY ag.id",
