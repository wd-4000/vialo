{
  "db_name": "PostgreSQL",
  "query": "SELECT\n            ba.id,\n            ba.asset_id,\n            ba.transaction_id,\n            jsonb_build_object('id', ba.account_id, 'full_name', COALESCE(ap.full_name, ag.label), 'type', (CASE WHEN ap.id IS NOT NULL THEN 'person' ELSE 'group' END)) AS \"account: AccountEmbed\",\n            lower(ba.during) as begins,\n            coalesce(upper(ba.during), '+infinity'::timestamptz) as \"ends!: PgDateTime\",\n            ba.cancelled_at,\n            ba.cancellation_reason as \"cancellation_reason: CancellationReason\",\n            ba.activated,\n            ba.maintenance,\n            null AS \"transaction: TransactionEmbed\",\n                        null AS \"refund_transaction: TransactionEmbed\"\n        FROM\n            bookable_appointments ba JOIN bookable_assets b ON b.id = ba.asset_id\n            LEFT JOIN accounts_people ap ON ba.account_id = ap.id LEFT JOIN account_groups ag ON ba.account_id = ag.id\n            LEFT JOIN credit_ledger cl ON ba.transaction_id = cl.id\n            LEFT JOIN credit_ledger clr ON clr.refund_of = cl.id\n            WHERE ba.id = $1 AND (ba.account_id = $2 OR account_bookable_perm_exists($2, b.asset_type_id, 'admin'::bookable_perm))",
