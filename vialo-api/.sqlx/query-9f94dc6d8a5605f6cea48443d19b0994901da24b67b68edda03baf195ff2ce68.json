  "query": "SELECT COUNT(*) > 0 AS \"has_perm: bool\"\n           FROM board_group_perms bgp\n           JOIN account_group_memberships agm ON bgp.group_id = agm.group_id\n           WHERE bgp.board_id = $1\n             AND agm.account_id = $2\n             AND bgp.perm >= $3",
