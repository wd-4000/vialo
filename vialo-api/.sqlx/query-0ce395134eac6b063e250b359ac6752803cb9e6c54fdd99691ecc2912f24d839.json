  "query": "SELECT net_devices.id, label, hostname,  mac AS \"mac: MacAddressWrapper\", cred_id, realm_id, net_devices.last_updated,  net_devices.last_seen, net_cred.network_id FROM net_devices\n                 JOIN net_cred ON cred_id = net_cred.id WHERE account_id = $1 AND net_cred.network_id = ANY($2) AND cred_id = $3  ORDER by net_devices.id LIMIT $4 OFFSET $5",
