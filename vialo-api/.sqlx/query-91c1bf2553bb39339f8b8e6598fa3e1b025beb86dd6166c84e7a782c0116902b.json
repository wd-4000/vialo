{
  "db_name": "PostgreSQL",
  "query": "SELECT\n                bp.id,\n                bp.account_id,\n                bp.board_id,\n                bp.icon,\n                -- Use get_i18n_string for title, content, and location translations with fallback\n                get_i18n_all_string_translations(bp.title) AS title,\n                NULL::jsonb as content,\n                get_i18n_all_string_translations(bp.content_plain) AS content_plain,\n                NULL::jsonb as content_html,\n                get_i18n_all_string_translations(bp.location) AS location,\n                bp.event_from,\n                bp.event_to,\n                bp.created_at\n            FROM\n                board_posts bp\n            WHERE bp.id = $1 AND (bp.visibility IN ('public', 'logged_in') OR account_board_perm_exists($2, bp.board_id, 'view'::board_perm))",
