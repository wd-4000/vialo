{
  "db_name": "PostgreSQL",
  "query": "SELECT\n            ba.id,\n            ba.asset_id,\n            ba.transaction_id,\n            CASE WHEN ba.account_id IS NOT NULL THEN jsonb_build_object('id', ba.account_id, 'full_name', COALESCE(ap.full_name, ag.label), 'type', (CASE WHEN ap.id IS NOT NULL THEN 'person' ELSE 'group' END)) END AS \"account: AccountEmbed\",\n            lower(ba.during) as begins,\n            coalesce(upper(ba.during), '+infinity'::timestamptz) as \"ends!: PgDateTime\",\n            ba.cancelled_at,\n            ba.cancellation_reason as \"cancellation_reason: CancellationReason\",\n            ba.activated,\n            ba.maintenance as \"maintenance: MaintenanceRefund\",\n            EXTRACT(EPOCH FROM ba.maintenance_refund_rolling_lead)::bigint as maintenance_refund_rolling_lead\n        FROM\n            bookable_appointments ba JOIN bookable_assets b ON b.id = ba.asset_id LEFT JOIN accounts_people ap ON ba.account_id = ap.id LEFT JOIN account_groups ag ON ba.account_id = ag.id WHERE true\n            AND (ba.account_id = $1 OR b.asset_type_id = ANY($2))\n            AND ($3::uuid IS NULL OR ba.account_id = $3)\n            AND ($4::int4[] IS NULL OR b.asset_type_id = ANY($4))\n            AND ba.during && tstzrange($5, $6)\n            AND ($7::bookable_appointment_cancellation_reason[] IS NULL\n                OR ba.cancellation_reason IS NULL OR ba.cancellation_reason = ANY($7))\n            ORDER BY lower(ba.during), upper(ba.during), ba.id LIMIT $8 OFFSET $9",
