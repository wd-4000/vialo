  "query": "SELECT\n            bs.id,\n            bs.label,\n            bs.schedule::text[] as \"schedule!\",\n            bs.asset_type_id,\n            bs.slot_price,\n            EXTRACT(EPOCH FROM bs.activation_grace_period)::bigint as activation_grace_period\n        FROM\n            bookable_schemas bs\n        WHERE bs.id = $1\n          AND account_bookable_perm_exists($2, bs.asset_type_id, 'view'::bookable_perm)",
