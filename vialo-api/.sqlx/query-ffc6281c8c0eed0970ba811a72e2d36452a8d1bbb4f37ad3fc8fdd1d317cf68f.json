{
  "db_name": "PostgreSQL",
  "query": "SELECT\n                bp.id,\n                bp.account_id,\n                bp.board_id,\n                bp.icon,\n                get_i18n_all_string_translations(bp.title) AS title,\n                CASE WHEN $1 THEN get_i18n_all_string_translations(bp.content) END AS content,\n                CASE WHEN $2 THEN get_i18n_all_string_translations(bp.content_html) END AS content_html,\n                CASE WHEN $3 THEN get_i18n_all_string_translations(bp.content_plain) END AS content_plain,\n                get_i18n_all_string_translations(bp.location) AS location,\n                bp.event_from,\n                bp.event_to,\n                bp.created_at,\n                bp.visibility AS \"visibility: PostVisibility\",\n                ARRAY(SELECT jsonb_build_object('id', m.id, 'status', m.status, 'mime', m.mime, 'size_bytes', m.size_bytes,\n                    'content', jsonb_build_object('type', m.type, 'width', m.width, 'height', m.height, 'variants', m.variants, 'filename', m.filename))\n                FROM media m WHERE m.post_id = bp.id ORDER BY m.position) AS \"media!: Vec<PostMediaModel>\"\n            FROM board_posts bp\n            WHERE bp.id = $4\n                -- visibility\n                AND (bp.visibility = 'public'\n                    OR ($5::uuid IS NOT NULL AND (bp.visibility = 'logged_in' OR account_board_perm_exists($5, bp.board_id, 'view'::board_perm))))",
