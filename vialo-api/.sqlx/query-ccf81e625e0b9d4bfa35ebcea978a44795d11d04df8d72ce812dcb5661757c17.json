{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, get_i18n_string(a.label, $1) AS label, a.url, a.icon, a.index, a.captive,\n        COALESCE(ARRAY_AGG(ag.group_id) FILTER (WHERE ag.id IS NOT NULL), ARRAY[]::uuid[]) AS \"group_ids!: Vec<Option<Uuid>>\"\n        FROM apps a LEFT JOIN app_group_perms ag ON a.id = ag.app_id GROUP BY a.id ORDER BY a.index, a.id LIMIT $2 OFFSET $3",
