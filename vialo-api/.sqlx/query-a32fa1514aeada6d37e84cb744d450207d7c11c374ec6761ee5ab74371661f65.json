  "query": "UPDATE subsystem_jobs SET status = 'processing', last_updated = NOW() WHERE id IN (SELECT id\n                             FROM subsystem_jobs\n                             WHERE subsystem = 'ppsk' AND (status = 'pending' OR (status = 'error' AND last_updated < NOW() - INTERVAL '5 minutes')) ORDER BY id ASC\n                             LIMIT 1) RETURNING id, data as \"data: Json<JobData>\", created_at, OLD.last_updated, OLD.status AS \"status: models::JobStatus\"",
