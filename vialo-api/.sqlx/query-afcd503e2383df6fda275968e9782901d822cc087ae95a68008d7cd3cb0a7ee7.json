  "db_name": "PostgreSQL",
  "query": "SELECT o.output_id,\n            o.name,\n            o.last_seen,\n            o.commissioned_at,\n            o.commission_error,\n            ARRAY(SELECT a.id FROM bookable_assets a\n                  WHERE a.connector = o.connector AND a.connector_output_id = o.output_id\n                  ORDER BY a.id) as \"assets!\"\n        FROM bookable_connector_outputs o\n        WHERE o.connector = $1\n        ORDER BY o.id",
