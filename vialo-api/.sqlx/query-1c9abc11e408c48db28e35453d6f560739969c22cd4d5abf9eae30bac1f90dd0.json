{
  "db_name": "PostgreSQL",
  "query": "SELECT nd.id, nd.label, nd.mac AS \"mac: MacAddressWrapper\", nd.mobileconfig, nd.cred_id, nd.last_updated, nd.last_seen, nd.hostname, nd.realm_id, nia.ipv4_addr as \"ipv4_addr?\", (row_to_json(nc)::jsonb - 'password' || jsonb_build_object('network', row_to_json(nn))) as \"cred: NetworkCredentialEmbed\", nc.password as \"cred_password: Encrypted<String>\",\n            jsonb_build_object('id', nc.account_id, 'full_name', coalesce(ap.full_name, ag.label), 'type', (CASE WHEN ap.id IS NOT NULL THEN 'person' ELSE 'group' END)) AS \"account!: AccountEmbed\"\n            FROM net_devices nd\n            JOIN net_cred nc ON nc.id = nd.cred_id\n            JOIN net_networks nn ON nc.network_id = nn.id\n            LEFT JOIN net_ip_assignments nia ON nia.device_id = nd.id\n            JOIN accounts_people ap ON nc.account_id = ap.id LEFT JOIN account_groups ag ON nc.account_id = ag.id WHERE account_id = $1 AND\n             nd.id = $2",
