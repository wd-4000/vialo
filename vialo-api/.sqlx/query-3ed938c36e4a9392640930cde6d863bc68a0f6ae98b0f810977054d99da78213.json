{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, get_i18n_string(a.label, $1) AS label, a.url, a.icon, a.index, a.captive,\n        ARRAY(SELECT group_id FROM app_group_perms WHERE app_id = a.id) AS \"group_ids!: Vec<Option<Uuid>>\"\n        FROM apps a WHERE a.id = $2 AND (account_role_exists($3, 'settings_manager') OR EXISTS (\n            SELECT 1 FROM app_group_perms ag\n            LEFT JOIN account_group_memberships agm ON ag.group_id = agm.group_id AND agm.account_id = $3\n            WHERE ag.app_id = a.id AND (ag.group_id IS NULL OR agm.account_id IS NOT NULL)\n        ))",
