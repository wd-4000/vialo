  "query": "SELECT\n                id,\n                icon,\n                get_i18n_string(name_i18n, $1) AS name,\n                asset_type,\n                status as \"status!: BookableStatus\",\n                lower(during) as begins,\n                upper(during)  as \"ends: PgDateTime\"\n            FROM\n                bookable_asset_status\n             ORDER BY id LIMIT $2 OFFSET $3",
