{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, get_i18n_string(a.label, $1) AS label, a.url, a.icon, a.index, a.captive\n    FROM apps a JOIN app_group_perms ag ON a.id = ag.app_id\n    LEFT JOIN account_group_memberships agm ON ag.group_id = agm.group_id AND agm.account_id = $2\n    WHERE ag.group_id IS NULL OR agm.account_id IS NOT NULL\n    GROUP BY a.id ORDER BY a.index, a.id LIMIT $3 OFFSET $4",
