{
  "db_name": "PostgreSQL",
  "query": "SELECT nd.id, label, hostname, realm_id, nd.last_updated,  nd.last_seen, jsonb_agg(jsonb_build_object('id', ndc.cred_id, 'network_id', nc.network_id, 'mac', ndc.mac) ORDER BY ndc.cred_id) AS \"creds!: DeviceCredEmbeds\"\n                FROM net_devices nd JOIN net_device_creds ndc ON nd.id = ndc.device_id\n                JOIN net_cred nc ON ndc.cred_id = nc.id WHERE ndc.account_id = $1    GROUP BY nd.id ORDER by nd.id LIMIT $2 OFFSET $3",
