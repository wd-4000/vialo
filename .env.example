# Frontend environment variables
# ORY_BASE_URL: Ory Kratos API endpoint (no trailing slash)
ORY_BASE_URL=http://localhost:4433

# URL_IMPRESSUM: URL to Impressum page
URL_IMPRESSUM=https://xyz.example.com/#impressum

# URL_PRIVACY_POLICY: URL to Privacy Policy page
URL_PRIVACY_POLICY=https://xyz.example.com/#datenschutz

# COPYRIGHT: Copyright text
COPYRIGHT=XYZ e.V.

# API_HOST: Backend API base URL (no trailing slash)
API_HOST=http://localhost:8000

# API_PATH: Backend API base path
API_PATH=/

# EMAIL_DOMAIN: Domain part of email addresses
EMAIL_DOMAIN=xyz.example.com

# APPNAME_USER: Short user-facing app name
APPNAME_USER=XYZ

# APPNAME_USER_LONG: Full user-facing app name
APPNAME_USER_LONG=X-ray-Yankee-Zulu

# APPNAME_ADMIN: Admin application name
APPNAME_ADMIN=XYZ Admin

# Vialo API environment variables
# DATABASE_URL: PostgreSQL connection string
DATABASE_URL=postgresql://{postgres_root_username}:{postgres_root_password}@localhost:5432/vialo?schema=public

# EMAIL_URL: SMTP connection string
EMAIL_URL=smtp://{email username}:{email password}@{email host}:{email port}/
